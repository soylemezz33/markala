# Markala — STAGING ortam değişkenleri
# VPS'te /opt/markala/.env.staging olarak kopyala ve değerleri doldur:
#   cp .env.staging.example .env.staging && nano .env.staging
# Kurulum rehberi: docs/STAGING.md

# --- Staging Postgres (proddan TAMAMEN ayrı DB) ---
STAGING_POSTGRES_DB=markala_staging
STAGING_POSTGRES_USER=markala
# Üret: openssl rand -base64 24
STAGING_POSTGRES_PASSWORD=

# --- API ---
# Üret: openssl rand -base64 32  (PROD JWT_SECRET'TAN FARKLI OLSUN)
STAGING_JWT_SECRET=
# EncryptionService için ≥32 karakter zorunlu. Üret: openssl rand -hex 24
STAGING_ENCRYPTION_KEY=

# --- Web ---
# Admin revalidate webhook secret'ı (staging'de admin yok, dummy değer yeterli)
STAGING_REVALIDATE_SECRET=staging-revalidate

# --- İsteğe bağlı: iyzico sandbox (ödeme akışı testi için) ---
STAGING_IYZICO_API_KEY=
STAGING_IYZICO_SECRET=

# --- Image registry (prod .env.production ile aynı değer) ---
GITHUB_REPOSITORY=soylemezz33/markala
