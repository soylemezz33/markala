# ─────────────────────────────────────────────
# Markala Web — Lokal kurulum için .env.local
# ─────────────────────────────────────────────
# Bu dosyayı `.env.local` olarak kopyala ve ilgili alanları doldur.
# Hiçbiri zorunlu değil — boşsa o özellik devre dışı kalır.
# ─────────────────────────────────────────────

# Backend API
NEXT_PUBLIC_API_URL=http://localhost:4000

# ─── E-posta (SMTP) ───
# İletişim formu ve bülten bildirimleri buradan gönderilir.
# SMTP_HOST boş veya "localhost" ise mail gönderimi DEVRE DIŞI kalır (sadece console.log).
# Değerler apps/api (NestJS) ile birebir aynı env adlarını kullanır.
# Üretimde MDaemon SMTP bilgilerini doldurun.
SMTP_HOST=
SMTP_PORT=
# TLS/SSL: 465 portu için "true", 587/25 (STARTTLS) için "false"
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Gönderen adresi, örn: Markala <markala@markala.com.tr>
MAIL_FROM=
# Form ve bülten bildirimlerinin gideceği adres (varsayılan: merhaba@markala.com.tr)
CONTACT_TO=

# ─── API İç Ağ (Docker Compose) ───
# Sunucu tarafı Next.js → API çağrısı için. Docker ağında container adını kullan.
# Boşsa NEXT_PUBLIC_API_URL'e düşer.
API_INTERNAL_URL=

# ─── ISR Cache Temizleme ───
# Admin paneli bir ürün güncellediğinde bu webhook'u çağırır.
# Admin ile AYNI değer olmalı. openssl rand -hex 32
REVALIDATE_SECRET=

# ─── Bakım Modu ───
# Bakım modunu atlatmak için HMAC imzalı çerez anahtarı. openssl rand -hex 32
MAINTENANCE_BYPASS_SECRET=

# ─── Cloudflare Turnstile (Bot Koruması) ───
# dash.cloudflare.com → Turnstile → Site ekle → markala.com.tr
# NEXT_PUBLIC_TURNSTILE_SITE_KEY: widget için (public, tarayıcıda görünür)
# TURNSTILE_SECRET_KEY: sunucu tarafı doğrulama (gizli)
# UYARI: üretimde TURNSTILE_SECRET_KEY tanımlanmazsa TÜM FORMLAR engellenir.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Google ile Giriş ───
# console.cloud.google.com → API'ler ve Hizmetler → OAuth 2.0 İstemci Kimliği
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ─── Analytics ───
# Google Analytics 4 — analytics.google.com → Mülk → Veri akışı → ölçüm kimliği
NEXT_PUBLIC_GA4_ID=

# Meta (Facebook) Pixel — business.facebook.com → Events Manager → Pixel ID
# KVKK: yalnızca marketing consent verildiğinde event gönderilir (bkz. lib/analytics.ts)
NEXT_PUBLIC_META_PIXEL_ID=

# Microsoft Clarity (ücretsiz ısı haritası) — clarity.microsoft.com → proje → tracking ID
NEXT_PUBLIC_CLARITY_ID=

# Hotjar (opsiyonel, ücretli) — hotjar.com → Site ID
NEXT_PUBLIC_HOTJAR_ID=

# Google Tag Manager (opsiyonel) — tagmanager.google.com → Container ID (GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=

# ─── Search Engine Verification ───
# Google Search Console → "URL prefix" → "HTML tag" → content="..." değerini buraya
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools → meta tag content değeri
NEXT_PUBLIC_BING_VERIFICATION=

# Yandex Webmaster
NEXT_PUBLIC_YANDEX_VERIFICATION=

# ─── Google Ads Dönüşüm Takibi ───
# ads.google.com → Araçlar → Dönüşümler → Etiket Kur → Manuel
NEXT_PUBLIC_ADS_CONVERSION_ID=
NEXT_PUBLIC_ADS_PURCHASE_LABEL=

# ─── KVKK İletişim Adresleri ───
# KVKK başvuruları bu adrese gider (varsayılan: merhaba@markala.com.tr)
KVKK_TO=

# ─── Anthropic AI (Opsiyonel) ───
# Ürün açıklaması asistanı. Tanımlanmazsa AI özelliği sessizce devre dışı kalır.
# console.anthropic.com → API Keys → Create Key
ANTHROPIC_API_KEY=
# Varsayılan: claude-haiku-4-5 (ucuz). Override için:
ANTHROPIC_MODEL=

# ─── A/B Testing ───
# JSON: aktif test ID listesi (cookie zaten otomatik atanır)
NEXT_PUBLIC_AB_TESTS=
