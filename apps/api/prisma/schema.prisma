// Markala — Prisma şeması
// Database: PostgreSQL
// Migrations: pnpm --filter @markala/api prisma:migrate
//
// 🔴 KURAL (2026-08-04 olayı): Bu dosyada model/kolon değiştiren HER commit, migrations/
// altına migration da eklemek ZORUNDA — api container'ı açılışta `prisma migrate deploy`
// çalıştırır; migration'sız şema değişikliği prod'da P2022 üretir (admin+cronlar çöker).
// CI'daki "Şema ↔ Migration bekçisi" job'ı bunu otomatik yakalar.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// === Kullanıcılar ===

enum AccountType {
  individual
  corporate
}

enum UserRole {
  customer
  admin
  super_admin
  /// Panel grupları (2026-08-21) — izinler kodda ROLE_PERMISSIONS'ta tanımlı.
  tasarimci
  muhasebe
  /// Kargo operasyonu (2026-09-01): siparişi görür, takip no girer; tutar/maliyet görmez.
  kargo
}

enum CorporateStatus {
  none
  pending
  approved
  rejected
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String      @map("password_hash")
  fullName     String      @map("full_name")
  phone        String?
  accountType  AccountType @default(individual) @map("account_type")
  role         UserRole    @default(customer)

  // Kurumsal alanlar (B2B)
  companyName          String?         @map("company_name")
  taxOffice            String?         @map("tax_office")
  taxNumber            String?         @map("tax_number")
  corporateStatus      CorporateStatus @default(none) @map("corporate_status")
  corporateApprovedAt  DateTime?       @map("corporate_approved_at")
  corporateDiscount    Decimal?        @map("corporate_discount") @db.Decimal(5, 2)
  corporateCreditLimit Decimal?        @map("corporate_credit_limit") @db.Decimal(12, 2)
  corporatePaymentTermDays Int?        @map("corporate_payment_term_days")

  // 2FA — secret artık AES-256-GCM ile şifreli saklanır (EncryptionService).
  // DB kolonu mevcut secret'a göre yeniden adlandırıldı: two_factor_secret_encrypted.
  twoFactorEnabled           Boolean  @default(false) @map("two_factor_enabled")
  twoFactorSecret            String?  @map("two_factor_secret_encrypted")
  // Backup kodları artık bcrypt ile hash'lenmiş tutulur (string array yerine kodun kendisi DB'de aranabilir değildir).
  twoFactorBackupCodesHashed String[] @default([]) @map("two_factor_backup_codes_hashed")

  // KVKK — pazarlama izni (açık rıza)
  marketingConsent       Boolean   @default(false) @map("marketing_consent")
  marketingConsentAt     DateTime? @map("marketing_consent_at")
  marketingConsentSource String?   @map("marketing_consent_source")

  // Duyuru tercihleri: { [typeId]: { email: bool, sms: bool } } — müşteri "Bildirim Tercihleri" ekranı.
  notificationPrefs Json? @map("notification_prefs")

  // Sadakat programı — denormalize puan bakiyesi (tek doğruluk kaynağı LoyaltyLedger).
  // Kazanım/harcama ledger yazımıyla birlikte atomik güncellenir.
  loyaltyPoints Int @default(0) @map("loyalty_points")

  emailVerifiedAt DateTime? @map("email_verified_at")
  lastLoginAt     DateTime? @map("last_login_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  addresses             Address[]
  orders                Order[]
  orderNotes            OrderNote[]
  designUploads         DesignUpload[]
  corporateApplications CorporateApplication[]
  ledgerEntries         CorporateLedgerEntry[]
  corporatePayments     CorporatePayment[]
  monthlyInvoices       CorporateMonthlyInvoice[]
  refreshTokens              RefreshToken[]
  emailVerificationTokens    EmailVerificationToken[]
  passwordResetTokens        PasswordResetToken[]
  notifications              NotificationLog[]
  consentLogs                ConsentLog[]
  favorites                  Favorite[]

  @@index([role])
  @@index([corporateStatus])
  @@index([deletedAt])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Birinci-parti ziyaretçi/davranış olayları — admin ziyaretçi analizi & CRM panelini besler.
/// userId opsiyonel plain string (FK YOK): olaylar kullanıcı silinse de korunur, cascade maliyeti yok.
model AnalyticsEvent {
  id          String   @id @default(cuid())
  type        String   // page_view | product_view | add_to_cart | begin_checkout | purchase | search | session_start
  sessionId   String   @map("session_id") // anonim ziyaretçi oturumu (cookie/localStorage uuid)
  userId      String?  @map("user_id") // giriş yapmışsa
  path        String?
  productSlug String?  @map("product_slug")
  dwellMs     Int?     @map("dwell_ms") // ürün inceleme süresi (ms)
  value       Decimal? @db.Decimal(12, 2) // sepet/sipariş tutarı (add_to_cart/purchase)
  referrer    String?
  device      String?  // mobile | desktop | tablet
  utmSource   String?  @map("utm_source")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([type, createdAt])
  @@index([productSlug, type])
  @@index([userId])
  @@index([sessionId])
  @@index([createdAt])
  @@map("analytics_events")
}

model CorporateApplication {
  id     String  @id @default(cuid())
  userId String? @map("user_id")

  companyName  String  @map("company_name")
  taxOffice    String  @map("tax_office")
  taxNumber    String  @map("tax_number")
  sector       String?
  annualVolume String? @map("annual_volume")

  contactName String  @map("contact_name")
  contactRole String? @map("contact_role")
  email       String
  phone       String
  address     String  @db.Text
  notes       String? @db.Text

  taxCertificateUrl    String? @map("tax_certificate_url")
  signatureCircularUrl String? @map("signature_circular_url")

  status       CorporateStatus @default(pending)
  reviewedById String?         @map("reviewed_by_id")
  reviewedAt   DateTime?       @map("reviewed_at")
  reviewNote   String?         @map("review_note") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([email])
  @@index([userId])
  @@map("corporate_applications")
}

// Cari hesap (açık hesap) defteri — kurumsal müşteri borç (debit) / ödeme (credit) hareketleri.
enum LedgerEntryKind {
  debit
  credit
}

model CorporateLedgerEntry {
  id          String          @id @default(cuid())
  userId      String          @map("user_id")
  orderId     String?         @map("order_id")
  kind        LedgerEntryKind
  amount      Decimal         @db.Decimal(12, 2)
  description String
  dueDate     DateTime?       @map("due_date")
  createdAt   DateTime        @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("corporate_ledger_entries")
}

/// Müşterinin panelinden online (iyzico) yaptığı cari hesap ödemesi (tahsilat).
/// Başarılı callback'te bir CorporateLedgerEntry(credit) oluşturulup bakiye düşürülür.
/// status: pending (iyzico'ya yönlendirildi) | paid (tahsil edildi) | failed.
model CorporatePayment {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  amount          Decimal   @db.Decimal(12, 2)
  status          String    @default("pending")
  iyzicoToken     String?   @map("iyzico_token")
  iyzicoPaymentId String?   @map("iyzico_payment_id")
  description     String?
  createdAt       DateTime  @default(now()) @map("created_at")
  paidAt          DateTime? @map("paid_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("corporate_payments")
}

/// Cari hesap (B2B açık hesap) AYLIK toplu faturası — Faz 3 otomatik aylık faturalama.
/// (userId, period) benzersiz → aynı müşteri/ay ikinci kez faturalanmaz (idempotent).
/// status: pending (kayıt açıldı) | issued (Paraşüt faturası kesildi) | failed | skipped (Paraşüt yapılandırılmamış).
model CorporateMonthlyInvoice {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  /// Faturalanan ay "YYYY-MM" (örn. "2026-05").
  period           String
  /// O aydaki açık-hesap siparişlerinin KDV dahil toplamı.
  totalAmount      Decimal   @map("total_amount") @db.Decimal(12, 2)
  orderCount       Int       @map("order_count")
  status           String    @default("pending")
  parasutInvoiceId String?   @map("parasut_invoice_id")
  issuedAt         DateTime? @map("issued_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period])
  @@index([period])
  @@map("corporate_monthly_invoices")
}

model Address {
  id          String  @id @default(cuid())
  userId      String  @map("user_id")
  label       String
  fullName    String  @map("full_name")
  phone       String
  city        String
  district    String
  fullAddress String  @map("full_address")
  zipCode     String? @map("zip_code")
  isDefault   Boolean @default(false) @map("is_default")

  // Fatura için adres tipi: "individual" (bireysel) | "corporate" (kurumsal).
  // Kurumsal adreslerde companyName + taxNumber zorunlu (DTO katmanında).
  type        String  @default("individual")
  companyName String? @map("company_name")
  taxOffice   String? @map("tax_office")
  taxNumber   String? @map("tax_number")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  shippingOrders Order[] @relation("ShippingAddress")
  billingOrders  Order[] @relation("BillingAddress")

  @@index([userId])
  @@map("addresses")
}

/// Favoriler — HESABA bağlı (2026-09-01, Hasan: "cihazlar arası senkron").
/// Önceden yalnız tarayıcı localStorage'ındaydı; telefonda eklenen masaüstünde görünmüyordu.
/// Ürün silinince favori de düşer (onDelete: Cascade) — ölü slug listede kalmaz.
model Favorite {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, createdAt])
  @@map("favorites")
}

// === Katalog ===

model Category {
  id               String  @id @default(cuid())
  slug             String  @unique
  name             String
  shortDescription String  @map("short_description")
  longDescription  String  @map("long_description")
  imageUrl         String  @map("image_url")
  accentColor      String? @map("accent_color")
  startingPrice    Decimal @map("starting_price") @db.Decimal(10, 2)
  productionTime   String  @map("production_time")
  sortOrder        Int     @default(0) @map("sort_order")
  isActive         Boolean @default(true) @map("is_active")
  content          Json?
  /// KÂR MARJI ÇARPANI (2026-08-27). Satış = maliyet × marj (örn. 1.8 → %80 kâr).
  /// null = kategoriye özel marj yok → global ayara (pricing.marj) düşer.
  /// ÖNCELİK: ürün → kategori → global. Bkz. apps/api/src/prices/margin.ts
  profitMargin     Decimal? @map("profit_margin") @db.Decimal(6, 3)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  @@index([isActive, sortOrder])
  @@map("categories")
}

model Product {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  categoryId       String   @map("category_id")
  shortDescription String   @map("short_description")
  description      String   @db.Text
  basePrice        Decimal  @map("base_price") @db.Decimal(10, 2)
  startingPrice    Decimal? @map("starting_price") @db.Decimal(10, 2)
  productionTime   String   @map("production_time")
  sizeLabel        String?  @map("size_label")
  images           String[]
  badges           String[] @default([])
  bestseller       Boolean  @default(false)
  ratingAverage    Decimal? @map("rating_average") @db.Decimal(3, 2)
  ratingCount      Int      @default(0) @map("rating_count")
  isActive         Boolean  @default(true) @map("is_active")
  /// Fiyatlama modu: "additive" (hücre-bazlı, mevcut) | "area" (m² bazlı maliyet motoru)
  pricingMode      String   @default("additive") @map("pricing_mode")
  /// KÂR MARJI ÇARPANI (2026-08-27) — ürüne ÖZEL. Satış = maliyet × marj (1.8 → %80 kâr).
  /// null = ürüne özel marj yok → kategori marjına, o da yoksa global ayara düşer.
  /// Marj yalnız "uygula" denince fiyatlara yazılır; kendiliğinden fiyat değiştirmez.
  profitMargin     Decimal? @map("profit_margin") @db.Decimal(6, 3)
  /// Konfigüratör parametreleri JSON: { id, label, kind, options, ... }
  parameters       Json     @default("[]")
  /// SEO/içerik JSON: { features, useCases, specifications, faqs, relatedSlugs, seo, brand, sku, rating }
  /// Storefront ürün sayfası bu zengin içeriği gösterir — API canonical kaynak olsun, SEO regresyonu olmasın.
  content          Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  category   Category       @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]
  reviews    Review[]
  prices     ProductPrice[]
  options    ProductOption[]
  favorites  Favorite[]

  @@index([categoryId, isActive])
  @@index([bestseller, isActive])
  @@map("products")
}

// === Sipariş ===

enum OrderStatus {
  siparis_alindi     @map("siparis-alindi")
  tasarim_bekleniyor @map("tasarim-bekleniyor")
  tasarim_onayindi   @map("tasarim-onayindi")
  uretimde
  kargoya_verildi    @map("kargoya-verildi")
  teslim_edildi      @map("teslim-edildi")
  iptal_edildi       @map("iptal-edildi")
}

enum PaymentStatus {
  beklemede
  basarili
  basarisiz
  iade_edildi @map("iade-edildi")
}

model Order {
  id          String  @id @default(cuid())
  orderNumber String  @unique @map("order_number")
  userId      String? @map("user_id")
  email       String
  phone       String

  status        OrderStatus   @default(siparis_alindi)
  paymentStatus PaymentStatus @default(beklemede) @map("payment_status")
  // Ödeme yolu: null/"iyzico" (online), "cari" (açık hesap/B2B), "havale" vb.
  paymentMethod String?       @map("payment_method")

  // Kuruş hassasiyeti için (12, 4); ara toplam/KDV/toplam yuvarlama hatasını azaltır.
  subtotal    Decimal @db.Decimal(12, 4)
  shippingFee Decimal @map("shipping_fee") @db.Decimal(10, 2)
  discount    Decimal @default(0) @db.Decimal(10, 2)
  vat         Decimal @db.Decimal(12, 4)
  total       Decimal @db.Decimal(12, 4)

  // Kayıtlı müşteri (hesabım > adreslerim) siparişlerinde FK doldurulur.
  // Storefront/misafir siparişlerinde adres kaydı yoktur (kullanıcı checkout'ta
  // satır-içi girer) — bu yüzden FK opsiyoneldir; adres aşağıdaki snapshot'ta tutulur.
  shippingAddressId String? @map("shipping_address_id")
  billingAddressId  String? @map("billing_address_id")

  // Satır-içi (misafir/storefront) adres snapshot'ı — FK yoksa kullanılır.
  // { fullName, phone, city, district, fullAddress, zipCode?, label? }
  shippingAddressSnapshot Json? @map("shipping_address_snapshot")
  billingAddressSnapshot  Json? @map("billing_address_snapshot")

  // iyzico referansları
  iyzicoPaymentId      String? @map("iyzico_payment_id")
  iyzicoConversationId String? @map("iyzico_conversation_id")

  // Kargo takibi
  trackingNumber  String?   @map("tracking_number")
  trackingCarrier String?   @map("tracking_carrier")
  shippedAt       DateTime? @map("shipped_at")
  deliveredAt     DateTime? @map("delivered_at")

  // iyzico checkout form token (init'te saklanır) — callback kaçarsa reconciliation bununla
  // ödemeyi retrieve edip siparişi kurtarır ("para çekildi ama işaretlenmedi" güvenlik ağı).
  iyzicoCheckoutToken String? @map("iyzico_checkout_token")

  // Meta Conversions API (sunucu-taraflı Purchase) için checkout'ta yakalanan sinyaller.
  // KVKK: marketingConsent=true DEĞİLSE hiçbir veri Meta'ya gönderilmez (payments → metaCapi.sendPurchase).
  marketingConsent Boolean @default(false) @map("marketing_consent")
  fbp              String? @map("fbp") // _fbp çerezi (Meta tarayıcı kimliği — eşleşme sinyali)
  fbc              String? @map("fbc") // _fbc çerezi (Meta tıklama kimliği — reklamdan gelenler)
  // Google Ads tıklama kimliği (_gcl_aw çerezi/URL'den) — offline dönüşüm/atıf eşleşmesi için.
  gclid            String? @map("gclid")
  // gbraid/wbraid: iOS/uygulama kampanyalarında gclid YERİNE gelir (2026-08-18 atıf çalışması).
  // Ayrı kolon olmazsa o trafiğin tamamı "kaynak bilinmiyor" görünür.
  gbraid           String? @map("gbraid")
  wbraid           String? @map("wbraid")
  // UTM: reklam DIŞI kanalları (e-posta, sosyal, AI asistan, organik kampanya) ölçülebilir kılar.
  utmSource        String? @map("utm_source")
  utmMedium        String? @map("utm_medium")
  utmCampaign      String? @map("utm_campaign")
  // Sipariş anı UA/IP snapshot'ı — Meta CAPI action_source=website için client_user_agent
  // fiilen zorunlu; client_ip_address eşleşme kalitesini artırır. Sadece bu amaçla saklanır.
  clientUserAgent  String? @map("client_user_agent")
  clientIp         String? @map("client_ip")

  // Paraşüt e-fatura
  parasutInvoiceId String? @map("parasut_invoice_id")

  // Bekleyen-ödeme kurtarma maili aşaması (LifecycleService saatlik cron).
  // 0 = hiç gönderilmedi, 1 = ilk hatırlatma (2-24 saat), 2 = son hatırlatma (24-72 saat).
  // İdempotens bu kolonla sağlanır: job aynı siparişe aynı aşamayı iki kez göndermez.
  recoveryMailStage Int @default(0) @map("recovery_mail_stage")

  // Yorum daveti email token ve gönderim kaydı (LifecycleService saatlik cron, teslimattan 24 saat sonra).
  // Token UUID; tek kullanımlık: yorum oluşturulunca NULL yapılır → ikinci gönderime imkân yok.
  // reviewEmailSentAt ile idempotens: NULL olan siparişe cron yeniden mail göndermez.
  reviewToken       String?   @unique @map("review_token")
  reviewEmailSentAt DateTime? @map("review_email_sent_at")

  notes String? @db.Text

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  // KVKK & Türk Ticaret Kanunu — mali kayıt 10 yıl saklanır; soft delete.
  deletedAt DateTime? @map("deleted_at")

  user            User?          @relation(fields: [userId], references: [id])
  shippingAddress Address?       @relation("ShippingAddress", fields: [shippingAddressId], references: [id])
  billingAddress  Address?       @relation("BillingAddress", fields: [billingAddressId], references: [id])
  items           OrderItem[]
  designUploads   DesignUpload[]
  // Panel içi not defteri. Order.notes AYRI bir şeydir: müşterinin checkout notunu ve
  // idempotency etiketini ([[idem:...]]) taşır, üzerine yazmak mükerrer sipariş korumasını
  // bozar. İç notlar bu yüzden kendi tablosunda ve ekleyen + zaman bilgisiyle tutulur.
  internalNotes   OrderNote[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([paymentMethod, createdAt]) // aylık cari faturalama paymentMethod='cari' taraması
  @@index([iyzicoConversationId])
  @@index([deletedAt])
  // Defense-in-depth: aynı iyzico ödemesi iki siparişe yazılamaz (DB seviyesinde garanti).
  // Postgres unique index çoklu NULL'a izin verir → ödenmemiş siparişler etkilenmez.
  @@unique([iyzicoPaymentId])
  @@map("orders")
}

// Sipariş iç notu (panel personeli arasında yazışma) — 2026-09-03.
// Ekleme-tabanlı: her not ayrı satır, kim/ne zaman ile. Düzenleme yok; yanlış yazılan
// not silinir (yazarı veya admin). Müşteri bu notları HİÇBİR yerde görmez.
model OrderNote {
  id      String @id @default(cuid())
  orderId String @map("order_id")
  // Yazan personel. Hesap silinirse not kalır (authorName snapshot'ı okunabilirliği korur).
  authorId   String? @map("author_id")
  authorName String  @map("author_name")
  authorRole String? @map("author_role")

  body String @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("order_notes")
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String @map("order_id")
  // Kampanya paketi (CampaignPackage — Product değil) kalemlerinde null; normal üründe dolu.
  productId String? @map("product_id")

  productSlug          String  @map("product_slug")
  productName          String  @map("product_name")
  productImage         String  @map("product_image")
  configurationSummary String  @map("configuration_summary")
  /// Konfigüratör seçimleri (snapshot)
  configuration        Json
  unitPrice            Decimal @map("unit_price") @db.Decimal(10, 2)
  quantity             Int
  lineTotal            Decimal @map("line_total") @db.Decimal(10, 2)
  /// Sipariş ANINDAKİ satır maliyeti (snapshot; lineTotal ölçeğinde, kalem adedi dahil).
  /// null = bilinmiyor (maliyeti girilmemiş ürün / kampanya paketi). Kâr raporu önce bunu
  /// okur; sonradan yapılan maliyet güncellemeleri geçmiş kârı DEĞİŞTİRMEZ. Bkz. orders/costing.ts
  costTotal            Decimal? @map("cost_total") @db.Decimal(10, 2)

  needsDesignSupport Boolean @default(false) @map("needs_design_support")
  uploadedFileName   String? @map("uploaded_file_name")
  uploadedFileUrl    String? @map("uploaded_file_url")
  /// Müşteri dosyası ödeme kesinleşince Drive sipariş klasörüne taşındıysa Drive dosya kimliği
  /// (2026-09-03). Dolu = taşındı (idempotency). Bkz. storage/order-drive.service.ts
  uploadedFileDriveId String? @map("uploaded_file_drive_id")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])
  /// Tasarımcının panelden bu satıra yüklediği dosyalar (önizleme/çalışma/baskı) — 2026-09-02.
  designUploads DesignUpload[]

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// === Tasarım yüklemeleri (R2 storage) ===

/// Sipariş SATIRINA bağlı tasarım dosyaları (2026-09-02, üretim ARGE Faz 2).
///
/// Bu tablo init'ten beri vardı ama HİÇBİR yerde yazılmıyor/okunmuyordu (ölü). Tasarımı
/// Markala'nın yaptığı siparişlerde bitmiş dosya sisteme hiç girmiyordu; üretimde "hangi
/// bayrak kimin" karışıklığının kök nedeni buydu. Artık panelden tasarımcı/admin yükler.
///
/// OrderItem.uploadedFile* (müşterinin checkout'ta yüklediği) AYNEN kalır; burası tasarımcı
/// tarafının dosyaları: önizleme (küçük RGB JPG — panelde tanıma için), çalışma (AI/PSD),
/// baskı (baskıya hazır PDF). Bir satırda birden çok dosya ve yeniden yükleme geçmişi tutulur.
model DesignUpload {
  id        String   @id @default(cuid())
  /// YÜKLEYEN panel kullanıcısı (tasarımcı/admin). Alan hiç kullanılmamıştı; anlamı bu şekilde
  /// tanımlandı ki User'a ikinci bir ilişki/FK açmak gerekmesin.
  userId    String?  @map("user_id")
  orderId   String?  @map("order_id")
  /// Hangi sipariş satırı. null = eski/kullanılmayan kayıt (tablo ölüyken veri yoktu).
  orderItemId String? @map("order_item_id")
  /// onizleme | calisma | baski — DTO'da ve DB CHECK'te doğrulanır. Prisma enum DEĞİL:
  /// ALTER TYPE ... ADD VALUE transaction içinde çalışmaz, migration tuzağı (bkz. kargo_role).
  kind      String   @default("calisma")
  fileName  String   @map("file_name")
  fileSize  Int      @map("file_size")
  fileUrl   String   @map("file_url")
  /// secure/tasarim altındaki depolama anahtarı (uuid.ext) — silme için. URL'den türetmek
  /// yerine açık tutuluyor; URL tabanı (API_PUBLIC_URL) değişse de silme doğru dosyayı bulur.
  storageKey String? @map("storage_key")
  mimeType  String   @map("mime_type")
  /// Faz 4 (Google Drive'a taşıma) için ayrıldı; şimdilik hep null.
  driveFileId String? @map("drive_file_id")
  createdAt DateTime @default(now()) @map("created_at")

  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  order     Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  /// Satır silinirse dosya kaydı anlamsız → Cascade (OrderItem.order ile aynı yaklaşım).
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([orderId])
  @@index([orderItemId])
  @@map("design_uploads")
}

// === Kuponlar ===

enum CouponType {
  percentage
  fixed_amount  @map("fixed-amount")
  free_shipping @map("free-shipping")
}

model Coupon {
  id             String     @id @default(cuid())
  code           String     @unique
  type           CouponType
  value          Decimal    @db.Decimal(10, 2)
  minOrderAmount Decimal?   @map("min_order_amount") @db.Decimal(10, 2)
  maxUses        Int?       @map("max_uses")
  usedCount      Int        @default(0) @map("used_count")
  validFrom      DateTime?  @map("valid_from")
  validUntil     DateTime?  @map("valid_until")
  isActive       Boolean    @default(true) @map("is_active")
  /// true ise kupon YALNIZCA müşterinin İLK siparişinde geçerli (HOSGELDIN gibi). Önceki siparişi
  /// olan kullanıcı/e-posta reddedilir. Tekrar kullanımı engeller.
  firstOrderOnly Boolean    @default(false) @map("first_order_only")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([code, isActive])
  @@map("coupons")
}

