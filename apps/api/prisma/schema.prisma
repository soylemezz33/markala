  earn
  spend
  adjust
}

/// Puan hareketleri. userId/orderId plain string (FK YOK — AnalyticsEvent deseni): kullanıcı/sipariş
/// silinse de mali iz korunur. @@unique([orderId, kind]) → aynı sipariş için kazanım/harcama YALNIZ
/// bir kez yazılır (callback+reconcile çift-tetiklese de idempotent, çift kazanım imkânsız).
model LoyaltyLedger {
  id           String           @id @default(cuid())
  userId       String           @map("user_id")
  orderId      String?          @map("order_id")
  kind         LoyaltyEntryKind
  points       Int // pozitif tamsayı; kind yönü belirler (earn=+, spend=-)
