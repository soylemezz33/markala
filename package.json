      "brace-expansion@^2": "^2.1.4",
      "fast-uri": "^3.1.5",
      "ip-address": "^10.3.1",
      "js-yaml@^4": "^4.3.1",
      "lodash": "^4.18.0",
      "nanoid@^3": "^3.3.18",
      "postcss": "^8.5.18",
      "body-parser@^1": "^1.20.6",
      "file-type@^21": "^21.3.2",
      "@babel/core": "^7.29.6",
      "multer": "^2.2.0",
      "rollup@^3": "^3.30.0",
      "form-data@^4": "^4.0.6",
      "ws@^8": "^8.21.0",
      "ws@^7": "^7.5.11",
      "picomatch@^4": "^4.0.4",
      "tmp": "^0.2.6",
      "qs@^6": "^6.15.2",
      "ajv@^8": "^8.18.0"
